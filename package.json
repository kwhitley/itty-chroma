{
  "name": "itty-chroma",
  "version": "1.0.1",
  "type": "module",
  "description": "Powerful styling for the browser console in under 500 bytes.",
  "main": "./chroma.js",
  "module": "./chroma.mjs",
  "types": "./chroma.d.ts",
  "exports": {
    ".": {
      "import": "./chroma.mjs",
      "require": "./chroma.js",
      "types": "./chroma.d.ts"
    }
  },
  "scripts": {
    "dev": "bun test --watch --coverage",
    "lint": "biome lint src",
    "verify": "echo 'verifying module...' && bun run build && bun test",
    "prerelease": "bun run verify",
    "prerelease:next": "bun run verify",
    "prebuild": "rm -rf dist && mkdir dist",
    "build": "rollup -c && cp LICENSE dist/ && bun readme-inject.mjs",
    "release": "release --tag --push --patch --src=dist",
    "release:next": "release --tag --push --type=next --src=dist"
  },
  "keywords": [
    "browser",
    "console",
    "logs",
    "color",
    "styles",
    "minimalist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwhitley/itty-chroma.git"
  },
  "author": "Kevin R. Whitley <krwhitley@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kwhitley/itty-chroma/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/bun": "^1.2.17",
    "rollup": "^4.28.1",
    "rollup-plugin-bundle-size": "^1.0.3",
    "typescript": "^5.7.2",
    "yarn-release": "^1.10.6"
  }
}
